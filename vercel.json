{
    "headers": [
        {
            "source": "/books/index.json",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        },
        {
            "source": "/books/:book((?!index$).*)\\.json",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/api/evangelizo/:match*",
            "destination": "https://feed.evangelizo.org/:match*"
        },
        {
            "source": "/api/vatican/:match*",
            "destination": "https://www.vaticannews.va/:match*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
